<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetLibVersion)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <PackageId>dotnet-agents-caldav</PackageId>
    <PackageType>McpServer</PackageType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-agents-caldav</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>CalDAV MCP server for Calendars, Events, and To-dos with revision-bound semantic and exact operations.</Description>
    <McpServerMetadataPath Condition="'$(McpServerMetadataPath)' == ''">$(MSBuildThisFileDirectory).mcp/server.json</McpServerMetadataPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetAgents.CalDav.Core\DotnetAgents.CalDav.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../skills/caldav-calendars/SKILL.md" Pack="true" PackagePath="skills/caldav-calendars/" />
    <EmbeddedResource Include="Contracts/mcp-tool-catalog.json" LogicalName="DotnetAgents.CalDav.Mcp.CalendarToolCatalog.json" />
    <None Include="$(McpServerMetadataPath)" Link=".mcp/server.json" Pack="true" PackagePath=".mcp/server.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>.mcp/server.json</TargetPath>
    </None>
  </ItemGroup>

</Project>
