<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(NetLibVersion)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <PackageId>dotnet-agents-caldav</PackageId>
    <PackageType>McpServer</PackageType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-agents-caldav</ToolCommandName>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>CalDAV MCP server for Calendars, Events, and To-dos with revision-bound semantic and exact operations.</Description>
    <McpServerMetadataPath Condition="'$(McpServerMetadataPath)' == ''">$(MSBuildThisFileDirectory).mcp/server.json</McpServerMetadataPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetAgents.CalDav.Core\DotnetAgents.CalDav.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="../../RELEASE_NOTES.md" Pack="true" PackagePath="\" />
    <None Include="../../contracts/0.2.0/mcp-tool-catalog.json" Pack="true" PackagePath="contracts/0.2.0/mcp-tool-catalog.json" />
    <None Include="../../contracts/0.2.0/mcp-server.schema.json" Pack="true" PackagePath="contracts/0.2.0/mcp-server.schema.json" />
    <None Include="../../contracts/0.2.0/mcp-authority-manifest.json" Pack="true" PackagePath="contracts/0.2.0/mcp-authority-manifest.json" />
    <None Include="../../contracts/0.2.0/release-evidence-map.json" Pack="true" PackagePath="contracts/0.2.0/release-evidence-map.json" />
    <None Include="../../contracts/0.2.1/mcp-tool-catalog.json" Pack="true" PackagePath="contracts/0.2.1/mcp-tool-catalog.json" />
    <None Include="../../contracts/0.2.1/mcp-server.schema.json" Pack="true" PackagePath="contracts/0.2.1/mcp-server.schema.json" />
    <None Include="../../contracts/0.2.1/mcp-authority-manifest.json" Pack="true" PackagePath="contracts/0.2.1/mcp-authority-manifest.json" />
    <None Include="../../contracts/0.2.1/radicale-3.7.8-profile.json" Pack="true" PackagePath="contracts/0.2.1/radicale-3.7.8-profile.json" />
    <None Include="../../contracts/0.2.1/compatibility-matrix.md" Pack="true" PackagePath="contracts/0.2.1/compatibility-matrix.md" />
    <None Include="../../contracts/0.2.1/requirement-evidence-catalog.md" Pack="true" PackagePath="contracts/0.2.1/requirement-evidence-catalog.md" />
    <None Include="../../contracts/0.2.1/release-evidence-map.json" Pack="true" PackagePath="contracts/0.2.1/release-evidence-map.json" />
    <None Include="../../docs/migrating-0.1.x-to-0.2.0.md" Pack="true" PackagePath="docs/migrating-0.1.x-to-0.2.0.md" />
    <None Include="../../docs/migrating-0.2.0-to-0.2.1.md" Pack="true" PackagePath="docs/migrating-0.2.0-to-0.2.1.md" />
    <None Include="../../skills/caldav-calendars/SKILL.md" Pack="true" PackagePath="skills/caldav-calendars/SKILL.md" />
    <EmbeddedResource Include="Contracts/mcp-tool-catalog.json" LogicalName="DotnetAgents.CalDav.Mcp.CalendarToolCatalog.json" />
    <None Include="$(McpServerMetadataPath)" Link=".mcp/server.json" Pack="true" PackagePath=".mcp/server.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>.mcp/server.json</TargetPath>
    </None>
  </ItemGroup>

</Project>
