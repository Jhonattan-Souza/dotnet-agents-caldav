diff --git a/tests/DotnetAgents.CalDav.Mcp.Tests.Unit/CalendarOccurrenceToolsTests.cs b/tests/DotnetAgents.CalDav.Mcp.Tests.Unit/CalendarOccurrenceToolsTests.cs
--- a/tests/DotnetAgents.CalDav.Mcp.Tests.Unit/CalendarOccurrenceToolsTests.cs
+++ b/tests/DotnetAgents.CalDav.Mcp.Tests.Unit/CalendarOccurrenceToolsTests.cs
@@ -16,6 +16,50 @@ public sealed class CalendarOccurrenceToolsTests
     private static readonly CalendarEntityUtcArgument From = new("utcDateTime", "2026-08-15T12:00:00Z");
     private static readonly CalendarEntityUtcArgument To = new("utcDateTime", "2026-08-16T12:00:00Z");
 
+    [Theory]
+    [InlineData(1)]
+    [InlineData(50)]
+    [InlineData(200)]
+    public async Task BaselineContinuationReexecutesTheComplete201OccurrenceQuery(int pageSize)
+    {
+        var items = Enumerable.Range(0, 201)
+            .Select(index => Occurrence(
+                "2026-08-15T12:00:00Z",
+                "https://cal.example/a/",
+                $"uid-{index:D3}",
+                "2026-08-15T10:00:00Z"))
+            .ToArray();
+        var service = Substitute.For<ICalendarService>();
+        service.QueryOccurrencesAsync(Arg.Any<CalendarOccurrenceQuery>(), Arg.Any<CancellationToken>())
+            .Returns(CalendarOccurrenceQueryResult.Success(items));
+        var sut = CreateTool(service, new MutableTimeProvider(Now));
+        string? cursor = null;
+        var observed = 0;
+        var calls = 0;
+
+        do
+        {
+            var result = await sut.QueryCoreAsync(
+                new CalendarEntityScopeArgument("all"),
+                From,
+                To,
+                CancellationToken.None,
+                evaluationTimeZone: "America/New_York",
+                pageSize: pageSize,
+                cursor: cursor);
+            result.IsError.ShouldBe(false);
+            observed += result.StructuredContent!.Value.GetProperty("items").GetArrayLength();
+            var cursorElement = result.StructuredContent.Value.GetProperty("pagination").GetProperty("nextCursor");
+            cursor = cursorElement.ValueKind == JsonValueKind.Null ? null : cursorElement.GetString();
+            calls++;
+        } while (cursor is not null);
+
+        observed.ShouldBe(201);
+        calls.ShouldBe((201 + pageSize - 1) / pageSize);
+        await service.Received(calls).QueryOccurrencesAsync(
+            Arg.Any<CalendarOccurrenceQuery>(), Arg.Any<CancellationToken>());
+    }
+
     [Theory]
     [InlineData(-1, false)]
     [InlineData(0, false)]
